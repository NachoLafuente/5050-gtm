# Copy to .env and fill in. Only set the keys for sources you actually use.

# Attio API key, get from Settings → Apps & integrations → API
# Required if --crm attio or --money attio
ATTIO_API_KEY=

# Stripe secret key, sk_live_... or sk_test_...
# Required if --crm stripe or --money stripe
STRIPE_SECRET_KEY=
